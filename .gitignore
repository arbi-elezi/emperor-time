# Emperor Time runtime artifacts — generated per task, not part of the skill
# Ignore contents (not the dir) so !.emperor/config.yaml can be committed.
.emperor/*
# Allow committed default adjustable-rigor config (schema v1)
!.emperor/config.yaml
# (includes .emperor/sdd/ plan-scoped SDD workspaces; also self-ignored via .emperor/sdd/.gitignore)


# Allow committed fixture graphs / trails for thoughttrail-super-context evals
!evals/
!evals/fixtures/
!evals/fixtures/**
!evals/fixtures/**/.emperor/
!evals/fixtures/**/.emperor/**

# Generated probe effort-cycles under fixtures (Bet N). Intentional committed stamps stay un-ignored:
evals/fixtures/**/effort-cycles.json
!evals/fixtures/ask-spec-proportionality/**/effort-cycles.json
!evals/fixtures/harness-plan-caps-enforce/**/effort-cycles.json
!evals/fixtures/harness-forbid-enforce/**/effort-cycles.json

# Local Claude Code state from plugin test-installs (never publish)
.claude/settings.local.json

# Holy Chain triage snapshots (no-VCS fallback copies)
*.holy-*

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
.idea/
.vscode/
__pycache__/
*.py[cod]

# Git worktree isolation (emperor-worktree)
.worktrees/
.apl.history
DUMP.mem
